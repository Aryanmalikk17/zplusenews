# Environment Variables for ZPluse News (BizzShort)
# Copy this file to .env and fill in your actual production values

# ============================================
# SERVER CONFIGURATION
# ============================================
# Port to listen on (default is 3000)
PORT=3000

# Environment setting (production or development)
NODE_ENV=production

# Canonical frontend site domain (for sitemaps and CSP headers)
SITE_URL=https://zplusenews.com

# ============================================
# DATABASE CONFIGURATION
# ============================================
# MongoDB connection URI (use your production cluster URL)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/zplusenews?retryWrites=true&w=majority

# ============================================
# SECURITY CONFIGURATION (Change these in production!)
# ============================================
# Secret key used to sign JSON Web Tokens (min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_characters

# JWT token duration (e.g. 30d, 7d, 24h)
JWT_EXPIRE=30d

# Setup key used to authorize initial/emergency admin seeding routes
SETUP_KEY=change_this_to_a_secure_random_string

# Default admin initial credentials (used for seeding)
DEFAULT_ADMIN_PASSWORD=your_secure_initial_admin_password

# ============================================
# CORS & NETWORKING CONFIGURATION
# ============================================
# Comma-separated allowed CORS origins
CORS_ORIGIN=https://zplusenews.com,https://www.zplusenews.com,http://localhost:3000,http://localhost:5173

# API Rate Limiting window duration in milliseconds (e.g. 900000 = 15 mins)
RATE_LIMIT_WINDOW_MS=900000

# Maximum number of API requests allowed within the rate limiting window
RATE_LIMIT_MAX_REQUESTS=500

# Maximum allowed size for uploaded files in bytes (default 5MB)
MAX_FILE_SIZE=5242880

# ============================================
# CLOUDINARY FILE STORAGE CONFIGURATION
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ============================================
# YOUTUBE SYNCING CONFIGURATION
# ============================================
# YouTube Data API Key for fetching channel metadata/videos
YOUTUBE_API_KEY=your_youtube_api_key_here

# Target YouTube Channel ID to sync videos from
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here

# YouTube handle of the channel (used as fallback resolution hint)
YOUTUBE_CHANNEL_HANDLE=@zplusenews

# ============================================
# PROKERALA API CONFIGURATION (Astrology/Ticker data)
# ============================================
PROKERALA_CLIENT_ID=your_prokerala_client_id_here
PROKERALA_CLIENT_SECRET=your_prokerala_client_secret_here
